# Created for you by: node app/scripts/make-wallets.mjs  -> .env.mainnet (never commit)
AGENT_KEY=
DEPLOYER_KEY=
MERCHANT_PAY_TO=
NETWORK=mainnet
# Optional, for a public deployment: live runs then need this key; recorded replay stays open to everyone.
# DEMO_KEY=

# --- GROWW product API (needed for the pay links, SDK and dashboard) ---
# Wallet that pays gas to relay payments. Holds HSK only, never USDC.
RELAYER_KEY=
# secp256k1 private key (PEM, \n-escaped on one line) GROWW signs carts with. Keep it stable.
MERCHANT_PRIVATE_KEY_PEM=
# Block the contract was deployed at (from chain/deployments/hashkey.json) so event reads stay fast.
SETTLER_FROM_BLOCK=
SETTLER_ADDRESS=
# Public URL of the site, used when building pay links (optional behind Render/Vercel).
# PUBLIC_URL=https://your-groww.onrender.com
# Limits on a single cart in USD.
# MAX_CART_USD=1000
# MIN_CART_USD=0.01
